{
  "manifest_version": 3,
  "name": "Lanes Integration",
  "version": "0.11.0",
  "description": "Tải liên kết và video trong trình duyệt bằng Lanes: nhiều kết nối, chọn độ phân giải, tạm dừng và tiếp tục.",
  "key": "",
  "minimum_chrome_version": "109",
  "permissions": ["downloads", "contextMenus", "cookies", "nativeMessaging", "storage", "notifications", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }],
  "action": { "default_title": "Lanes", "default_popup": "popup.html" },
  "icons": { "16": "icon-128.png", "48": "icon-128.png", "128": "icon-128.png" }
}
